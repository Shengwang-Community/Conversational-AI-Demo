# Uncomment the next line to define a global platform for your project
source 'https://cdn.cocoapods.org/'

minimum_ios_version = '16.0'
platform :ios, minimum_ios_version

target 'Agent-cn' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!
  
  pod 'Kingfisher'
  pod 'SSZipArchive'
  pod 'SwiftyBeaver', '1.9.5'
  pod 'ZSwiftBaseLib', '0.1.6.2'
  pod 'Bugly'
#  pod 'ShengwangRtcEngine_iOS', :path => 'sdk.podspec'
  # The full SDK includes and loads the AINS/AIAEC extension frameworks.
  pod 'ShengwangRtcEngine_iOS', '4.6.4'
  # Upstream 1.0.1 pins RTC 4.5.2; these overrides adapt its native observer to 4.6.4.
  pod 'AvatarKitRTC', :podspec => 'ThirdParty/Spatius/AvatarKitRTC.podspec.json'
  pod 'AvatarKitAgoraBridge', :path => 'ThirdParty/Spatius/AvatarKitAgoraBridge'
  # Keep the official Toolkit binary, selecting the domestic RTC and RTM Pod names.
  pod 'agent-client-toolkit-swift', :podspec => 'ThirdParty/AgentClientToolkit/agent-client-toolkit-swift.podspec.json'
  # RTC supplies AOSL through ShengwangInfra_iOS; do not also include RTM's RtmBasic.
  pod 'ShengWang-Rtm', '2.3.0', :subspecs => ['RtmKit']
  #pod 'LookinServer', :subspecs => ['Swift'], :configurations => ['Debug']
  
  pod 'Common', :path => 'Common'

  # Agents
  pod 'ConvoAI', :path => 'Scenes/ConvoAI/ConvoAI'
  pod 'IoT', :path => 'Scenes/ConvoAI/IoT'
  pod 'BLEManager', :path => 'Scenes/ConvoAI/BLEManager'

  target 'Agent-cnTests' do
    inherit! :complete
  end
end

post_install do |installer|
  resource_url = "https://accktvpic.oss-cn-beijing.aliyuncs.com/ConvoAI/Resource/Convo_AI_Demo_v2.0.0_Resource.zip"
  download_path = "#{Dir.pwd}/Agent/Resources/Convo_AI_Demo_v2.0.0_Resource.zip"
  extract_path = "#{Dir.pwd}/Agent/Resources"
  video_names = %w[ball_video_start.mp4 ball_video_rotating.mp4]

  if video_names.all? { |name| File.file?(File.join(extract_path, name)) }
    Pod::UI.puts "Convo AI Demo animation videos already exist."
  elsif ENV["SKIP_DEMO_RESOURCE_DOWNLOAD"] == "1"
    raise Pod::Informative, "Animation videos are missing; rerun without SKIP_DEMO_RESOURCE_DOWNLOAD."
  else
    Pod::UI.puts "Downloading Convo AI Demo resources..."
    download_success = system('curl', '-fL', resource_url, '-o', download_path)

    unless download_success
      Pod::UI.warn "[!] Resource download failed. Please check your network connection and try again."
      raise Pod::Informative, "Resource download failed"
    end

    if File.exist?(download_path)
      Pod::UI.puts "Download completed successfully."

      Pod::UI.puts "Extracting resources..."
      # Extract only the UI videos, excluding macOS archive metadata.
      extract_success = system('unzip', '-j', '-o', download_path,
                               *video_names.map { |name| "*/#{name}" }, '-d', extract_path)

      unless extract_success
        Pod::UI.warn "[!] Resource extraction failed."
        raise Pod::Informative, "Resource extraction failed"
      end

      File.delete(download_path)

      Pod::UI.puts "Resource settings completed."
    else
      Pod::UI.warn "[!] Resource download failed. Please check your network connection and try again."
      raise Pod::Informative, "Resource download failed"
    end
  end
  
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Xcode 27 rejects legacy Pod deployment targets below iOS 15. Keep every
      # dependency compatible with the app's minimum, preserving higher requirements.
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new(minimum_ios_version)
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
      end
    end
  end
end
