{
  "schema_version": 1,
  "surface": "codex",
  "max_attempts": 3,
  "finding_routes": {
    "implementation": "platform",
    "unit_test": "platform",
    "cross_platform_parity": "platforms",
    "test_coverage": "test-design",
    "test_evidence": "test-verification",
    "ux_requirement": "ux-design",
    "ux_implementation": "platform",
    "architecture": "architect",
    "requirement": "product",
    "environment": "blocked"
  },
  "models": {
    "primary": {
      "default": "gpt-5.6-sol",
      "env": "AI_ENGINEERING_PRIMARY_MODEL"
    },
    "review": {
      "default": "gpt-5.4",
      "env": "AI_ENGINEERING_REVIEW_MODEL"
    }
  },
  "roles": {
    "product": {
      "required": true,
      "condition": "always",
      "depends_on": [],
      "model": "primary",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "requirement-brief.md"
    },
    "knowledge": {
      "required": true,
      "condition": "always",
      "depends_on": ["product"],
      "model": "primary",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "repo-context.md"
    },
    "architect": {
      "required": true,
      "condition": "always",
      "depends_on": ["knowledge"],
      "model": "primary",
      "reasoning_effort": "xhigh",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "architecture-decision.json"
    },
    "ux-design": {
      "required": false,
      "condition": "ux_required",
      "depends_on": ["architect"],
      "model": "primary",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "ux-spec.json"
    },
    "test-design": {
      "required": true,
      "condition": "always",
      "depends_on": ["architect", "ux-design"],
      "model": "primary",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "test-matrix.json"
    },
    "test-verification": {
      "required": true,
      "condition": "always",
      "depends_on": ["platforms"],
      "model": "review",
      "reasoning_effort": "high",
      "sandbox": "workspace-write",
      "working_directory": ".",
      "artifact": "test-verification.json"
    },
    "ux-acceptance": {
      "required": false,
      "condition": "ux_required",
      "depends_on": ["test-verification"],
      "model": "review",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "ux-acceptance.json"
    },
    "acceptance-reviewer": {
      "required": true,
      "condition": "always",
      "depends_on": ["test-verification", "ux-acceptance"],
      "model": "review",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "working_directory": ".",
      "artifact": "acceptance-review.json"
    }
  },
  "platforms": {
    "android": {
      "model": "primary",
      "reasoning_effort": "high",
      "sandbox": "workspace-write",
      "working_directory": "Android",
      "workflow_entrypoints": [
        "Android/AGENTS.md",
        "Android/.agents/skills/ac-workflow/SKILL.md"
      ]
    },
    "ios": {
      "model": "primary",
      "reasoning_effort": "high",
      "sandbox": "workspace-write",
      "working_directory": "iOS",
      "workflow_entrypoints": [
        "iOS/.agents/skills/convoai-ios-workflow/SKILL.md"
      ]
    }
  }
}
